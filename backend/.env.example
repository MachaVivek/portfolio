# Template for your secrets. Copy it to .env and fill in real values:
#   cp .env.example .env
#
# .env is gitignored — it never gets committed or built into the Docker image.
# The app starts and responds sensibly even with everything below left blank,
# so you can run it first and add keys as you go.
#
# Don't wrap values in quotes, and watch for trailing spaces.

# --- Who's allowed to call this API from a browser ---
# Comma-separated. Add your real Vercel URL here once the frontend is deployed.
ALLOWED_ORIGINS=http://localhost:3000

# --- Signing key for email drafts ---
# This is what stops someone forging an email draft and using the API to send
# mail from your domain. Leaving it blank is safe — a random key is generated at
# startup — but that key changes on every restart, so a draft someone was midway
# through confirming stops working, and separate workers can't verify each
# other's drafts.
#
# Set a long random string in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Gemini (the AI) ---
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Qdrant (vector database for portfolio search) ---
# Free cluster at https://cloud.qdrant.io/
QDRANT_URL=
QDRANT_API_KEY=

# --- Supabase (Postgres, stores chat history) ---
# Project Settings -> API. Use the service_role key, NOT the anon key.
# This key is server-side only and must never reach the frontend.
SUPABASE_URL=
SUPABASE_KEY=

# --- GitHub (live repo lookups) ---
# Token: https://github.com/settings/tokens (read access to public repos is enough)
GITHUB_TOKEN=
GITHUB_USERNAME=
# Comma-separated exact repo names the AI is allowed to look up.
# Leave blank to disable repo lookups entirely.
GITHUB_ALLOWED_REPOS=

# --- Resend (sending contact emails) ---
# API key: https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend.
RESEND_FROM_EMAIL=
# Your own email — where visitor messages arrive.
CONTACT_EMAIL_TO=

# --- Login for your /admin dashboard ---
# Pick anything; these are just for you.
ADMIN_USERNAME=
ADMIN_PASSWORD=
